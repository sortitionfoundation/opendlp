{
  "html": "<form action=\"{{ form_action }}\" method=\"post\">\n{{ csrf_form_element }}\n{{ form_errors() }}\n<h2>Eligibility</h2>\n<label><input type=\"checkbox\" id=\"eligible\" name=\"eligible\" value=\"yes\" {{ checked('eligible', 'yes') }} required> Eligible</label>\n{{ field_errors('eligible') }}\n<label><input type=\"checkbox\" id=\"can_attend\" name=\"can_attend\" value=\"yes\" {{ checked('can_attend', 'yes') }} required> Can attend</label>\n{{ field_errors('can_attend') }}\n<h2>Name and contact</h2>\n<label for=\"email\">Email</label>\n<input type=\"email\" id=\"email\" name=\"email\" value=\"{{ value('email') }}\" required>\n{{ field_errors('email') }}\n<label for=\"first_name\">First name</label>\n<input type=\"text\" id=\"first_name\" name=\"first_name\" value=\"{{ value('first_name') }}\" required>\n{{ field_errors('first_name') }}\n<h2>Consent</h2>\n<label><input type=\"checkbox\" id=\"consent\" name=\"consent\" value=\"yes\" {{ checked('consent', 'yes') }} required> Consent</label>\n{{ field_errors('consent') }}\n<label><input type=\"checkbox\" id=\"stay_on_db\" name=\"stay_on_db\" value=\"yes\" {{ checked('stay_on_db', 'yes') }}> Stay on database</label>\n{{ field_errors('stay_on_db') }}\n<button type=\"submit\">Register</button>\n</form>\n",
  "html_govuk": "<div class=\"govuk-grid-row\">\n<div class=\"govuk-grid-column-two-thirds\" style=\"float: none; margin: 0 auto;\">\n<form action=\"{{ form_action }}\" method=\"post\">\n{{ csrf_form_element }}\n{{ form_errors() }}\n<h2 class=\"govuk-heading-l\">Eligibility</h2>\n<div class=\"govuk-form-group\">\n<div class=\"govuk-checkboxes\" data-module=\"govuk-checkboxes\">\n<div class=\"govuk-checkboxes__item\">\n<input class=\"govuk-checkboxes__input\" type=\"checkbox\" id=\"eligible\" name=\"eligible\" value=\"yes\" {{ checked('eligible', 'yes') }} required>\n<label class=\"govuk-label govuk-checkboxes__label\" for=\"eligible\">Eligible</label>\n</div>\n{{ field_errors('eligible') }}\n</div>\n</div>\n<div class=\"govuk-form-group\">\n<div class=\"govuk-checkboxes\" data-module=\"govuk-checkboxes\">\n<div class=\"govuk-checkboxes__item\">\n<input class=\"govuk-checkboxes__input\" type=\"checkbox\" id=\"can_attend\" name=\"can_attend\" value=\"yes\" {{ checked('can_attend', 'yes') }} required>\n<label class=\"govuk-label govuk-checkboxes__label\" for=\"can_attend\">Can attend</label>\n</div>\n{{ field_errors('can_attend') }}\n</div>\n</div>\n<h2 class=\"govuk-heading-l\">Name and contact</h2>\n<div class=\"govuk-form-group\">\n<label class=\"govuk-label\" for=\"email\">Email</label>\n<input class=\"govuk-input\" type=\"email\" id=\"email\" name=\"email\" value=\"{{ value('email') }}\" required>\n{{ field_errors('email') }}\n</div>\n<div class=\"govuk-form-group\">\n<label class=\"govuk-label\" for=\"first_name\">First name</label>\n<input class=\"govuk-input\" type=\"text\" id=\"first_name\" name=\"first_name\" value=\"{{ value('first_name') }}\" required>\n{{ field_errors('first_name') }}\n</div>\n<h2 class=\"govuk-heading-l\">Consent</h2>\n<div class=\"govuk-form-group\">\n<div class=\"govuk-checkboxes\" data-module=\"govuk-checkboxes\">\n<div class=\"govuk-checkboxes__item\">\n<input class=\"govuk-checkboxes__input\" type=\"checkbox\" id=\"consent\" name=\"consent\" value=\"yes\" {{ checked('consent', 'yes') }} required>\n<label class=\"govuk-label govuk-checkboxes__label\" for=\"consent\">Consent</label>\n</div>\n{{ field_errors('consent') }}\n</div>\n</div>\n<div class=\"govuk-form-group\">\n<div class=\"govuk-checkboxes\" data-module=\"govuk-checkboxes\">\n<div class=\"govuk-checkboxes__item\">\n<input class=\"govuk-checkboxes__input\" type=\"checkbox\" id=\"stay_on_db\" name=\"stay_on_db\" value=\"yes\" {{ checked('stay_on_db', 'yes') }}>\n<label class=\"govuk-label govuk-checkboxes__label\" for=\"stay_on_db\">Stay on database</label>\n</div>\n{{ field_errors('stay_on_db') }}\n</div>\n</div>\n<button type=\"submit\" class=\"govuk-button\" data-module=\"govuk-button\">Register</button>\n</form>\n</div>\n</div>\n",
