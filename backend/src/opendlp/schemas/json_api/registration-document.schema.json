{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendlp.sortitionfoundation.org/schemas/json_api/registration-document.schema.json",
  "title": "Registration document response",
  "description": "Returned by the registration PDF upload (201) and label update (200) routes.",
  "type": "object",
  "properties": {
    "document": {
      "$ref": "#/$defs/document"
    }
  },
  "required": [
    "document"
  ],
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "label": {
          "type": "string",
          "description": "Human-readable label. Empty when the uploader gave none."
        },
        "original_filename": {
          "type": "string",
          "description": "Empty when the upload carried no filename."
        },
        "file_name": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}\\.pdf$",
          "description": "Content-addressed: the SHA-256 of the stored bytes."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "description": "Label, else original filename, else a truncated hash. Never empty."
        },
        "public_url": {
          "type": "string",
          "description": "Empty when the registration page has no slug yet."
        },
        "a_snippet": {
          "type": "string",
          "description": "Ready-to-paste <a> download link, html-escaped. Empty when public_url is."
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "aria_label_details": {
          "type": "string",
          "minLength": 1
        },
        "aria_label_copy_snippet": {
          "type": "string",
          "minLength": 1
        },
        "aria_label_delete": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label",
        "original_filename",
        "file_name",
        "display_name",
        "public_url",
        "a_snippet",
        "byte_size",
        "aria_label_details",
        "aria_label_copy_snippet",
        "aria_label_delete"
      ],
      "additionalProperties": false
    }
  }
}
