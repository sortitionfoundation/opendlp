{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendlp.sortitionfoundation.org/schemas/json_api/password-check.schema.json",
  "title": "Password check",
  "description": "The answer of POST /auth/password-check: whether a password meets each of the sign-up page's password rules, decided by the server's validators. One boolean per rule, by the rule's key (password_rule_results()); never a validator's message.",
  "type": "object",
  "properties": {
    "rules": {
      "type": "object",
      "properties": {
        "length": {
          "type": "boolean"
        },
        "not-numbers-only": {
          "type": "boolean"
        },
        "not-common": {
          "type": "boolean"
        },
        "not-similar": {
          "type": "boolean"
        }
      },
      "required": [
        "length",
        "not-numbers-only",
        "not-common",
        "not-similar"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "rules"
  ],
  "additionalProperties": false
}
