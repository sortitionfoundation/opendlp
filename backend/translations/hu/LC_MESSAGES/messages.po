msgid "Number of features found: %(count)s"
msgstr "Talált kiválasztási szempontok száma: %(count)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid ""
"Reading in '%(tab_name)s' tab (header at row %(header_row)s) in above "
"Google sheet."
msgstr ""
"'%(tab_name)s' munkalap beolvasása (fejléc %(header_row)s. sorban) a "
"fenti Google Táblázatból."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Opened Google Sheet: '%(title)s'."
msgstr "Megnyitott Google Táblázat: '%(title)s'."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "Using legacy algorithm."
msgstr "A régi algoritmus fut."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "Using maximin algorithm."
msgstr "A maximin algoritmus fut."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "Using leximin algorithm."
msgstr "A leximin algoritmus fut."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "Using Nash algorithm."
msgstr "A Nash-algoritmus fut."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "Had to switch to ECOS solver."
msgstr "Váltás szükséges volt az ECOS megoldóra."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid ""
"The leximin algorithm requires the optimization library Gurobi to be "
"installed (commercial, free academic licenses available). Switching to "
"the simpler maximin algorithm, which can be run using open source "
"solvers."
msgstr ""
"A leximin algoritmushoz telepíteni kell a Gurobi optimalizálási "
"könyvtárat (kereskedelmi, ingyenes akadémiai licenccel elérhető). Váltás "
"az egyszerűbb maximin algoritmusra, amely nyílt forráskódú megoldókkal is"
" futtatható."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid ""
"Algorithm produced distribution over %(total_committees)s committees, out"
" of which %(non_zero_committees)s are chosen with positive probability."
msgstr ""
"Az algoritmus %(total_committees)s csoport-összeállítás fölötti eloszlást"
" állított elő, amelyek közül %(non_zero_committees)s kerül kiválasztásra "
"pozitív valószínűséggel."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid ""
"INFO: The distribution over panels is what is known as a 'basic "
"solution'. There is no reason for concern about the correctness of your "
"output, but we'd appreciate if you could reach out to "
"panelot@paulgoelz.de with the following information: "
"algorithm=%(algorithm)s, num_panels=%(num_panels)s, "
"num_agents=%(num_agents)s, min_probs=%(min_probs)s."
msgstr ""
"INFORMÁCIÓ: A csoport-összeállítások fölötti eloszlás az úgynevezett "
"„bázismegoldás”. Nincs okod aggódni a kimenet helyessége miatt, de "
"hálásak lennénk, ha jeleznéd a panelot@paulgoelz.de címen a következő "
"adatokkal: algorithm=%(algorithm)s, num_panels=%(num_panels)s, "
"num_agents=%(num_agents)s, min_probs=%(min_probs)s."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Agent %(agent_id)s not contained in any feasible committee."
msgstr ""
"%(agent_id)s azonosítójú jelölt egyetlen megvalósítható csoport-"
"összeállításban sem szerepel."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Scaled Nash welfare is now: %(scaled_welfare)s."
msgstr "A skálázott Nash-jólét mostantól: %(scaled_welfare)s."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid ""
"Maximin is at most %(at_most)s, can do %(upper_str)s with "
"%(num_committees)s committees. Gap %(gap_str)s."
msgstr ""
"A maximin legfeljebb %(at_most)s, %(num_committees)s csoport-"
"összeállítással %(upper_str)s érhető el. Eltérés: %(gap_str)s."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid ""
"Leximin is at most %(at_most)s, can do %(dual_obj_str)s with "
"%(num_committees)s committees. Gap %(gap_str)s."
msgstr ""
"A leximin legfeljebb %(at_most)s, %(num_committees)s csoport-"
"összeállítással %(dual_obj_str)s érhető el. Eltérés: %(gap_str)s."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "WARNING: Panel is not selected at random! Only use for testing!"
msgstr ""
"FIGYELEM: A csoport-összeállítás nem véletlenszerűen lett kiválasztva! "
"Csak tesztelésre használd!"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "Initial: (selected = 0)"
msgstr "Kezdet: (kiválasztva = 0)"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Trial number: %(trial)s"
msgstr "Kísérlet száma: %(trial)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "SUCCESS!! Final:"
msgstr "SIKER!! Végeredmény:"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Failed %(attempts)s times. Gave up."
msgstr "%(attempts)s alkalommal sikertelen volt. A futás megszakadt."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Failed one attempt. Selection Error raised - will retry. %(error)s"
msgstr ""
"Egy kísérlet sikertelen volt. Kiválasztási hiba történt – újrapróbálkozás"
" következik. %(error)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid ""
"No target checks done for multiple selections - please see your output "
"files."
msgstr ""
"Több kiválasztás esetén nem történik célszám-ellenőrzés – nézd meg a "
"kimeneti fájljaidat."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid ""
"We do not calculate target details for multiple selections - please see "
"your output files."
msgstr ""
"Több kiválasztás esetén nem készül célszám-részletezés – nézd meg a "
"kimeneti fájljaidat."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Writing selected rows to %(file_path)s"
msgstr "A kiválasztott sorok írása ide: %(file_path)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Writing remaining rows to %(file_path)s"
msgstr "A fennmaradó sorok írása ide: %(file_path)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Writing selected people to tab: %(tab_name)s"
msgstr "A kiválasztott emberek írása erre a munkalapra: %(tab_name)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Writing remaining people to tab: %(tab_name)s"
msgstr "A fennmaradó emberek írása erre a munkalapra: %(tab_name)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid ""
"Finished writing selected (only, because writing remaining is deselected "
"in the configuration)"
msgstr ""
"A kiválasztottak kiírása kész (csak azoké, mert a fennmaradók kiírása ki "
"van kapcsolva a beállításokban)"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "Finished writing both selected and remaining"
msgstr "A kiválasztottak és a fennmaradók kiírása is kész"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "WARNING: blank cell found in ID column in row %(row)s - skipped that line!"
msgstr ""
"FIGYELEM: üres cella az azonosító oszlopban %(row)s. sorban – ez a sor "
"kimaradt!"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "WARNING: Duplicate people found:"
msgstr "FIGYELEM: Ismétlődő emberek találhatók:"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Person with ID '%(person_id)s' appears %(count)s times in rows: %(rows)s"
msgstr ""
"'%(person_id)s' azonosítójú személy %(count)s alkalommal szerepel a "
"következő sorokban: %(rows)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Found %(count)s IDs that have more than one row"
msgstr "%(count)s olyan azonosító található, amelyhez több sor tartozik"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Duplicated IDs are: %(ids)s"
msgstr "Az ismétlődő azonosítók: %(ids)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "All duplicate rows have identical data - processing continuing."
msgstr ""
"Minden ismétlődő sor azonos adatokat tartalmaz – a feldolgozás "
"folytatódik."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid "All agents are contained in some feasible committee."
msgstr "Minden jelölt szerepel valamelyik megvalósítható csoport-összeállításban."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Heuristic successfully generated %(count)s additional committees."
msgstr ""
"A heurisztika sikeresen létrehozott %(count)s további csoport-"
"összeállítást."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Using these settings: %(settings)s"
msgstr "A használt beállítások: %(settings)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid "Random seed set to: %(seed)s"
msgstr "A véletlenszám-mag beállítva erre: %(seed)s"

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
#, python-format
msgid ""
"Wrote default settings to '%(file_path)s' - if editing is required, "
"restart this app."
msgstr ""
"Az alapértelmezett beállítások ide íródtak: '%(file_path)s' – ha "
"szerkesztésre van szükség, indítsd újra ezt az alkalmazást."

#: .venv/lib/python3.14/site-packages/sortition_algorithms/report_messages.py
msgid ""
"WARNING: Settings file is such that we do NOT check if respondents have "
